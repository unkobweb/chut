# --- Network ---
PORT=8787
# Public URL of the service. This is what goes into the link sent to the human.
BASE_URL=http://localhost:8787

# --- Agent auth ---
# Accepted API keys, comma-separated. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_KEYS=dev_change_me

# --- Storage ---
DB_PATH=./data/chut.db

# --- Policy ---
DEFAULT_TTL_SECONDS=900
MAX_TTL_SECONDS=86400
MAX_SECRET_BYTES=8192
# Max request creations per minute per API key
RATE_LIMIT_PER_MIN=60

# Salt used to hash filling IPs (raw IPs are never stored).
# Change this in production, otherwise the hashes are guessable.
IP_HASH_SALT=change_me_too
