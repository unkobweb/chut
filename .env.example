# --- Reseau ---
PORT=8787
# URL publique du service. C'est elle qui est mise dans le lien envoye a l'humain.
BASE_URL=http://localhost:8787

# --- Auth agent ---
# Cles API acceptees, separees par des virgules. Genere-les avec:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_KEYS=dev_change_me

# --- Stockage ---
DB_PATH=./data/chut.db

# --- Politique ---
DEFAULT_TTL_SECONDS=900
MAX_TTL_SECONDS=86400
MAX_SECRET_BYTES=8192
# Nombre max de creations de demande par minute et par cle API
RATE_LIMIT_PER_MIN=60

# Sel pour hacher les IP de remplissage (on ne stocke jamais d'IP en clair).
# Change-le en prod, sinon les hachages sont devinables.
IP_HASH_SALT=change_me_too
