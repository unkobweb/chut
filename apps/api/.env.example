# --- Network ---
PORT=8787
# Public URL of the service. This is what goes into the link sent to the human.
BASE_URL=http://localhost:8787

# --- Storage ---
DB_PATH=./data/chut.db

# --- Policy ---
DEFAULT_TTL_SECONDS=900
MAX_TTL_SECONDS=86400
MAX_SECRET_BYTES=8192
# Max requests per minute per caller address
RATE_LIMIT_PER_MIN=60

# Salt used to hash filling IPs (raw IPs are never stored).
# Change this in production, otherwise the hashes are guessable.
IP_HASH_SALT=change_me_too

# How many trusted reverse proxies sit in front of this service.
# 0 (default) ignores X-Forwarded-For entirely: with nothing in front, any caller
# could otherwise pick the address recorded against their fill and rotate it to
# dodge rate limits. Set it to the real number of hops when you deploy behind a
# proxy, or the per-IP buckets collapse into one and the filling fingerprint
# becomes the proxy's address for everyone.
TRUST_PROXY_HOPS=0
