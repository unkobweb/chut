{
  "name": "handoff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Un agent IA demande un secret a son humain via un lien ephemere. Le serveur ne voit jamais le secret en clair.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
